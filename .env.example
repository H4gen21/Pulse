# Copy to .env and fill in. Never commit real values.

# ── Database (Supabase) ─────────────────────────────────────────
# Pooled connection (pgbouncer, port 6543), used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# Direct connection (port 5432), used by `prisma migrate`
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ── Auth (SIWE via NextAuth) ────────────────────────────────────
# Host must match the domain users sign in on
NEXTAUTH_URL="http://localhost:3000"
# openssl rand -base64 32  (different per environment)
NEXTAUTH_SECRET=""

# ── Chain ───────────────────────────────────────────────────────
# 84532 = Base Sepolia, 8453 = Base mainnet
NEXT_PUBLIC_CHAIN_ID="84532"
# Server-side RPC (e.g. Alchemy Base Sepolia)
RPC_URL=""
NEXT_PUBLIC_GUARD_CONTRACT_ADDRESS=""
# Only read on Base mainnet; Base Sepolia uses Circle's official testnet USDC from lib/contract.ts
NEXT_PUBLIC_USDC_CONTRACT_ADDRESS=""

# ── Wallets ─────────────────────────────────────────────────────
# https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""

# ── Rate limiting (optional; falls back to in-memory if unset) ──
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Contract deployment (local only, never in Vercel/CI) ────────
# Prefer `forge create --interactive` or `cast wallet import` over storing a key here.
DEPLOYER_PRIVATE_KEY=""
