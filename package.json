{
  "name": "pulse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:fork": "node scripts/dev-fork.mjs",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:contracts": "forge test -vv",
    "abi:gen": "node scripts/gen-abi.mjs",
    "check:staging": "node scripts/check-staging-imports.mjs",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@rainbow-me/rainbowkit": "^2.2.0",
    "@tanstack/react-query": "^5.59.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.40.0",
    "lucide-react": "^0.454.0",
    "next": "14.2.15",
    "next-auth": "^4.24.10",
    "react": "^18",
    "react-dom": "^18",
    "viem": "^2.21.0",
    "wagmi": "^2.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@chainlink/contracts": "^1.3.0",
    "@openzeppelin/contracts": "^5.1.0",
    "@playwright/test": "1.48.2",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.15",
    "postcss": "^8",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^2.1.4"
  },
  "pnpm": {
    "overrides": {
      "@solana/kit": "^8.0.0"
    }
  }
}
